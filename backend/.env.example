# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.app
DEBUG=True

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_intelligence

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production

# Flask Secret Key
SECRET_KEY=your-flask-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
